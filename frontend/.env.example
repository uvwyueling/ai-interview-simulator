# ── DeepSeek API ─────────────────────────────────────────────────────────────
# Used via DeepSeek's Anthropic-compatible endpoint (https://api.deepseek.com/anthropic).
# Server-side only. Never prefix with NEXT_PUBLIC_. Get it from platform.deepseek.com.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase (analytics sink for /api/track) ─────────────────────────────────
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# SERVICE ROLE key — server-side only, bypasses RLS. NEVER expose to the client,
# never prefix with NEXT_PUBLIC_. Found in: Supabase Dashboard → Project Settings
# → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# ── ASR / 高准确转写 (/api/transcribe) ────────────────────────────────────────
# Which speech provider handles the post-recording high-accuracy pass.
# Unset or unknown  → the feature is unavailable; the app stays on browser-only
#                     transcription and the UI says so. A typo degrades, it does
#                     not break the interview page.
#   mock            → echoes the browser draft back. Local dev, CI and product
#                     acceptance: exercises the whole pipeline with no vendor and
#                     no spend.
#   openai          → INTERNAL TESTING ONLY, not the shipping vendor.
# The final vendor is not chosen yet; adding it means one file under
# src/lib/asr/providers/ plus one case in src/lib/asr/provider.ts.
ASR_PROVIDER=mock

# Optional, `mock` only — makes the pending 「正在优化转写…」 state observable and
# lets its abort edges be tested locally.
# ASR_MOCK_DELAY_MS=2000
# Optional, `mock` only — perturbs the returned text so the "upgrade succeeded"
# path (and the transcript 👍/👎, which only appears when the cloud changed
# something) is reachable without a real vendor. Never set in production.
# ASR_MOCK_MUTATE=1

# Required only when ASR_PROVIDER=openai. Server-side only. Never prefix with
# NEXT_PUBLIC_. Get it from platform.openai.com.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
