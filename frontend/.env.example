# ── DeepSeek API ─────────────────────────────────────────────────────────────
# Used via DeepSeek's Anthropic-compatible endpoint (https://api.deepseek.com/anthropic).
# Server-side only. Never prefix with NEXT_PUBLIC_. Get it from platform.deepseek.com.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase (analytics sink for /api/track) ─────────────────────────────────
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# SERVICE ROLE key — server-side only, bypasses RLS. NEVER expose to the client,
# never prefix with NEXT_PUBLIC_. Found in: Supabase Dashboard → Project Settings
# → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# ── ASR / 高准确转写 (/api/transcribe) ────────────────────────────────────────
# Which speech provider handles the post-recording high-accuracy pass.
# Unset or unknown  → the feature is unavailable; the app stays on browser-only
#                     transcription and the UI says so. A typo degrades, it does
#                     not break the interview page.
#   mock            → echoes the browser draft back. Local dev, CI and product
#                     acceptance: exercises the whole pipeline with no vendor and
#                     no spend.
#   openai          → INTERNAL TESTING ONLY, not the shipping vendor.
#   xfyun           → 讯飞 OST (极速录音转写) — the shipping vendor.
#                     ⚠️ PAID, billed per second of audio. Every recorded answer
#                     is a real charge, so keep local development on `mock`
#                     unless you are deliberately testing the vendor.
ASR_PROVIDER=mock

# Optional, `mock` only — makes the pending 「正在优化转写…」 state observable and
# lets its abort edges be tested locally.
# ASR_MOCK_DELAY_MS=2000
# Optional, `mock` only — perturbs the returned text so the "upgrade succeeded"
# path (and the transcript 👍/👎, which only appears when the cloud changed
# something) is reachable without a real vendor. Never set in production.
# ASR_MOCK_MUTATE=1

# Required only when ASR_PROVIDER=openai. Server-side only. Never prefix with
# NEXT_PUBLIC_. Get it from platform.openai.com.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Required only when ASR_PROVIDER=xfyun. ALL THREE are needed — the request
# signature is HMAC-SHA256 over the API secret, so a missing one degrades the
# feature to browser-only rather than erroring. Server-side only; never prefix
# with NEXT_PUBLIC_. From console.xfyun.cn → your app → 极速录音转写.
# Note this is a different scheme from 讯飞's other transcription product
# (lfasr), which uses signa/HmacSHA1 — credentials are not interchangeable.
# XFYUN_APP_ID=xxxxxxxx
# XFYUN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# XFYUN_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloud-ASR spend cap ───────────────────────────────────────────────────────
# Ceiling on cloud-ASR audio per UTC day, in SECONDS (the vendor's billing unit).
# Applies only to paid providers — `mock` is never counted.
#
# Backed by a shared counter in Supabase, so it holds across serverless
# instances and cold starts (the in-memory rateLimit does not).
#   ⚠️ Requires docs/supabase-asr-usage.sql to have been run ONCE in the
#      Supabase SQL editor. Until then the route FAILS CLOSED for paid
#      providers: it refuses the upgrade and keeps the browser draft, rather
#      than spending without a bound. That is deliberate.
#
# Unset → 3600 (one hour of audio/day). The default is intentionally low: a
# forgotten config should cost a capped amount, not run up a bill.
# ASR_DAILY_SECONDS_LIMIT=3600
